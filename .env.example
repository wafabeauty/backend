# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://wafabeauty:wafabeauty@wafabeauty_database:5432/wafabeauty

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://wafabeauty.shop,https://www.wafabeauty.shop,http://localhost:3000

# ── Google Sheets Webhook ─────────────────────────────────────────────────────
WEBHOOK_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# Secret sent as X-Webhook-Secret header — validate it inside your Apps Script
SHEETS_WEBHOOK_SECRET=your_random_secret_here

# ── Facebook CAPI ─────────────────────────────────────────────────────────────
ENABLE_FB_CAPI=true
FB_API_VERSION=v20.0
FB_ACCESS_TOKEN=your_fb_capi_token
FB_PIXEL_ID=your_fb_pixel_id

# ── TikTok CAPI ───────────────────────────────────────────────────────────────
ENABLE_TIKTOK_CAPI=true
TIKTOK_API_VERSION=v1.3
TIKTOK_ACCESS_TOKEN=your_tiktok_capi_token
TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# ── Snapchat CAPI ─────────────────────────────────────────────────────────────
ENABLE_SNAP_CAPI=true
SNAP_ACCESS_TOKEN=your_snap_capi_token
SNAP_PIXEL_ID=your_snap_pixel_id

# ── MaxMind GeoIP2 ────────────────────────────────────────────────────────────
# Blocks non-KSA orders and VPN/proxy/Tor traffic
# Get credentials at: https://www.maxmind.com/en/accounts/current/license-key
ENABLE_GEOIP=true
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key
# Comma-separated phones whitelisted from GeoIP check (for testing)
GEOIP_WHITELISTED_PHONES=+971558406027
