# ── Public API URL (backend) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.wafabeauty.shop

# ── Pixel IDs (leave blank to disable) ─────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# ── MaxMind GeoIP (optional — used by the Next.js /api/validate-ip route) ──
# Get credentials at: https://www.maxmind.com/en/accounts/current/license-key
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
